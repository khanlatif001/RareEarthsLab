		<region region-id="11756" left="24" top="618" width="418.5" height="298.5" align-x="24" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#e9e9e9" tag="">
			<plot disable-calc="false" item-idref="32"/>
			<rendering item-idref="33"/>
		</region>
		<region region-id="11822" left="498" top="764.25" width="236.25" height="48" align-x="501" align-y="774" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ff8080" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="decimal" tabs="inherit">Normalization condition to guarantee the convergence criteria.</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="decimal" tabs="inherit">The value of this integral must be <b>equal to 1</b> independently of the simulation time chosen (T1). </p>
			</text>
		</region>
		<region region-id="12911" left="498" top="817.5" width="234" height="51.75" align-x="714" align-y="846" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ff8080" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:integral auto-algorithm="true" algorithm="adaptive"/>
						<ml:lambda>
							<ml:boundVars>
								<ml:id xml:space="preserve">t1</ml:id>
							</ml:boundVars>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:id xml:space="preserve" subscript="0">P</ml:id>
													<ml:id xml:space="preserve">t1</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve" subscript="1">P</ml:id>
													<ml:id xml:space="preserve">t1</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve" subscript="2">P</ml:id>
												<ml:id xml:space="preserve">t1</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve" subscript="3">P</ml:id>
											<ml:id xml:space="preserve">t1</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve" subscript="4">P</ml:id>
										<ml:id xml:space="preserve">t1</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:id xml:space="preserve">T1</ml:id>
							</ml:apply>
						</ml:lambda>
						<ml:bounds>
							<ml:real>0</ml:real>
							<ml:id xml:space="preserve">T1</ml:id>
						</ml:bounds>
					</ml:apply>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.99999999999208955</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="34"/>
		</region>
		<region region-id="11766" left="6" top="917.25" width="470.25" height="18" align-x="18.75" align-y="930" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Figure 1</b>. Transient of the populations for the <sup>2</sup>F<sub>5/2</sub> (P<sub>3</sub>, right-side scale) and T<sub>1</sub> (P<sub>1</sub>, left-side scale) levels. </p>
			</text>
